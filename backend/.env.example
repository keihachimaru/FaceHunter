# ─── Server ────────────────────────────────────
PORT=3000

# ─── MongoDB ───────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/facehunterdb

# ─── JWT — BOTH CASINGS REQUIRED ───────────────
# The code reads both JWT_SECRET and Jwt_SECRET due to
# inconsistent casing across files. Set both to the same value.
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_64_hex_char_string
Jwt_SECRET=change_me_to_a_random_64_hex_char_string

# ─── Cloudinary ────────────────────────────────
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me
